; 光尘层：加色混合，叠在解析光效之上，模拟空气中的浮尘。
[sub_resource type="CanvasItemMaterial" id="CanvasItemMaterial_spark"]
blend_mode = 1

[sub_resource type="Gradient" id="Gradient_spark"]
offsets = PackedFloat32Array(0, 0.14, 0.55, 1)
colors = PackedColorArray(1, 0.95, 0.72, 0, 1, 0.94, 0.7, 0.95, 1, 0.76, 0.32, 0.55, 0.98, 0.6, 0.12, 0)

[sub_resource type="GradientTexture1D" id="GradientTexture1D_spark"]
gradient = SubResource("Gradient_spark")

; 从光心向四周扩散：极小的球形发射口 + 径向加速度，叠一点切向加速度做旋涡感。
; 初速/加速度按「最远飞行距离 ≈ v·t + ½·a·t² ≈ 60px（等比 0.30）」反推，
; 与 star_reach / ray_reach 对齐，否则光尘会跑到光芒之外拖出一条长尾。
[sub_resource type="ParticleProcessMaterial" id="ParticleProcessMaterial_spark"]
lifetime_randomness = 0.6
emission_shape = 1
emission_sphere_radius = 2.0
angle_min = -180.0
angle_max = 180.0
direction = Vector3(0, -1, 0)
spread = 180.0
initial_velocity_min = 3.0
initial_velocity_max = 12.0
radial_accel_min = 5.0
radial_accel_max = 14.0
tangential_accel_min = -4.0
tangential_accel_max = 4.0
gravity = Vector3(0, 0, 0)
damping_min = 2.0
damping_max = 8.0
scale_min = 0.04
scale_max = 0.14
color_ramp = SubResource("GradientTexture1D_spark")
turbulence_enabled = true
turbulence_noise_strength = 0.18
turbulence_noise_frequency = 2.4

